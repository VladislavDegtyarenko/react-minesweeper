{
  "name": "react-minesweeper",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "check:env": "node scripts/check-env.js",
    "dev": "node scripts/check-env.js --mode development && rm -rf .next && next dev",
    "build": "node scripts/check-env.js --mode production && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.2.7",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.8",
    "canvas-confetti": "^1.9.4",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.34.0",
    "immer": "^11.1.3",
    "next": "^16.1.1",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.7",
    "sass": "^1.97.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.38",
    "prettier": "^3.8.1",
    "typescript": "^5.2.2"
  }
}
