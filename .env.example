# Clerk auth (https://dashboard.clerk.com)
# Pull these from your Clerk app's "API keys" page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Tell Clerk where our custom catch-all auth pages live so <SignInButton> /
# <SignUpButton> route inside the app instead of Clerk's hosted portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Neon Postgres (https://console.neon.tech)
# DATABASE_URL is the *pooled* connection (used by the running app on Vercel).
# DATABASE_URL_UNPOOLED is the *direct* connection (used by drizzle-kit migrations).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public site URL. Use http://localhost:3000 for local development.
# In Vercel, set this to your production domain (e.g. https://example.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
